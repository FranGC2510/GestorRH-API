<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================
         PROPIEDADES
    ================================================================ -->
    <property name="LOG_DIR" value="logs"/>

    <!-- ================================================================
         APPENDERS GLOBALES
    ================================================================ -->

    <!-- Consola — texto plano legible, solo para dev y test -->
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Fichero JSON dev -->
    <appender name="FICHERO_JSON_DEV" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/gestorrh-dev.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/gestorrh-dev.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeCallerData>false</includeCallerData>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxLength>30</maxLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- ================================================================
         PERFILES
    ================================================================ -->

    <springProfile name="dev">
        <root level="WARN">
            <appender-ref ref="CONSOLA"/>
            <appender-ref ref="FICHERO_JSON_DEV"/>
        </root>
        <logger name="com.gestorrh.api" level="INFO" additivity="false">
            <appender-ref ref="CONSOLA"/>
            <appender-ref ref="FICHERO_JSON_DEV"/>
        </logger>
    </springProfile>

    <springProfile name="prod">
        <appender name="FICHERO_JSON_PROD" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/gestorrh.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/gestorrh.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>false</includeCallerData>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxLength>30</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="FICHERO_JSON_PROD"/>
            <appender-ref ref="CONSOLA"/>
        </root>
        <logger name="com.gestorrh.api" level="INFO" additivity="false">
            <appender-ref ref="FICHERO_JSON_PROD"/>
            <appender-ref ref="CONSOLA"/>
        </logger>
    </springProfile>

    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLA"/>
        </root>
        <logger name="com.gestorrh.api" level="INFO" additivity="false">
            <appender-ref ref="CONSOLA"/>
        </logger>
    </springProfile>

</configuration>