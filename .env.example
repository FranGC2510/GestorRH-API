# PLANTILLA DE VARIABLES DE ENTORNO (PRODUCCIÓN)

# Instrucciones: Copia este archivo, renómbralo a '.env'
# y sustituye los valores por tus credenciales reales.

# 1. Credenciales de la Base de Datos PostgreSQL
DB_USERNAME=tu_usuario_aqui
DB_PASSWORD=tu_password_segura_aqui

# 2. Seguridad JWT (Generar una cadena de 64 caracteres en Base64)
JWT_SECRET=tu_clave_secreta_generada_aleatoriamente_aqui

# 3. Credenciales de Actuator (monitorización del sistema)
# Usuario y contraseña para acceder a los endpoints de Spring Boot Actuator.
# Acceso exclusivo del administrador del sistema, independiente del JWT de la aplicación.
ACTUATOR_USER=tu_usuario_actuator_aqui
ACTUATOR_PASSWORD=tu_password_actuator_aqui

# 4. Credenciales de Spring Boot Admin (panel de monitorización)
# Usuario y contraseña para acceder al dashboard de Spring Boot Admin.
# Independientes del JWT de la aplicación y de las credenciales de Actuator.
ADMIN_USER=tu_usuario_admin_aqui
ADMIN_PASSWORD=tu_password_admin_aqui

# 5. Rate limiting en endpoints públicos de autenticación y registro
# Límite de intentos de login por IP en la ventana de tiempo configurada.
# Por defecto: 10 intentos cada 5 minutos por IP y endpoint.
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=5
# Límite de intentos de registro por IP en la ventana de tiempo configurada.
# Por defecto: 5 intentos cada 10 minutos por IP.
RATE_LIMIT_REGISTRO_MAX_REQUESTS=5
RATE_LIMIT_REGISTRO_WINDOW_MINUTES=10